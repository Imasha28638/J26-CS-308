{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pp1/member2_to_member4_proto_v1.schema.json",
  "title": "Member 2 to Member 4 PROTO v1 Handoff",
  "description": "Current binary CloudTrail activity-finding interface; proposal until Member 4 approves.",
  "type": "object",
  "required": ["schema_version", "status", "source", "score_type", "findings"],
  "properties": {
    "schema_version": {"const": "member2_to_member4_proto_v1"},
    "status": {"const": "PROTO_EVALUATION"},
    "source": {"const": "member2_pp1_binary_stacking"},
    "score_type": {"const": "uncalibrated_model_score"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "additionalProperties": true,
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["finding_id", "event_window_start_utc", "actor_hash", "activity", "predicted_binary", "stacking_score", "model_disagreement", "api_operations", "aws_services", "event_count", "evidence_record_numbers", "attack_category"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "event_window_start_utc": {"type": "string", "pattern": "Z$"},
        "actor_hash": {"type": "string", "minLength": 1},
        "activity": {"enum": ["BENIGN_PATTERN", "MALICIOUS_PATTERN"]},
        "predicted_binary": {"type": "integer", "enum": [0, 1]},
        "stacking_score": {"type": "number", "minimum": 0, "maximum": 1},
        "model_disagreement": {"type": "number", "minimum": 0, "maximum": 1},
        "api_operations": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
        "aws_services": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "event_count": {"type": "integer", "minimum": 1},
        "evidence_record_numbers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "attack_category": {"type": "null"}
      },
      "additionalProperties": true
    }
  }
}
